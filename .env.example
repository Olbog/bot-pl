# Токен от @BotFather
TELEGRAM_TOKEN=
# Адрес Cloudflare Worker, без слеша в конце
WORKER_URL=https://gemini-proxy.contactmoneytalksmedia.workers.dev
# Пароль Worker (то же значение, что PROXY_TOKEN в Cloudflare)
PROXY_TOKEN=
# Твой Telegram ID (узнаешь, написав боту при пустом значении). Несколько — через запятую
ALLOWED_USER_IDS=

# Необязательное
# Цепочка моделей через запятую, от лучшей к худшей. Пусто — цепочка по умолчанию (см. bot/gemini.py)
GEMINI_MODELS=
# Показывать под ответом, какая модель ответила (1/0)
SHOW_MODEL=1
GEMINI_THINKING_LEVEL=low
LEVEL=A1–A2
TTS_VOICE=pl-PL-ZofiaNeural
TTS_RATE=-10%
HISTORY_LIMIT=20
